APP_NAME=HostWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ==========================================================
# BASE DE DONNÉES
# ------------------------------------------------------------
# EN LOCAL (développement) : MySQL via XAMPP
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hostwatch
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------
# EN PRODUCTION (Render) : décommenter ces lignes, commenter
# celles au-dessus, OU définir DB_CONNECTION=pgsql directement
# dans les variables d'environnement du dashboard Render.
# DATABASE_URL est fournie automatiquement par Render.
# ------------------------------------------------------------
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ==========================================================
# QUEUE — en production sur Render (plan gratuit, sans worker
# séparé), on utilise "sync" : les jobs s'exécutent immédiatement
# dans la requête, sans file d'attente ni worker.
# En local, tu peux garder "database" si tu utilises queue:work.
# ==========================================================
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=
FRONTEND_URL=http://localhost:5173
